[e] screenPage
    [e] parameters
        [e] modelName
            [v] NOT_DEFINED
        [e] package
            [v] NOT_DEFINED
    [e] vars
        [e] mapNativeTypes
            [e] select
                [v] //maps/mapNativeTypes
        [e] classes
            [e] select
                [v] /classes
    [e] patterns
        [e] header
            [v] // GERADO por frontend/screenPage a partir de {{ @name }}. Nao edite: a saida e sobrescrita por inteiro.
        [e] err-create-dialog
            [v] // ERRO NO MODELO: lista {{ @name }} abre '{{ $badOpens }}' fora da pagina unica: cadastro deve criar na pagina unica: opens deve apontar para window.editor com rota /x/{{ '$id' }}
        [e] err-fixed-field
            [v] // ERRO NO MODELO: fixedFilter {{ $fname }} sem atributo escalar correspondente em {{ $bean }} na lista {{ $janela }} (o campo deve existir como atributo do bean da source)
        [e] err-fixed-value
            [v] // ERRO NO MODELO: fixedFilter {{ $fname }} sem value em {{ $janela }} (declare o valor literal: true|false|texto|numero)
        [e] import-react
            [v] import { {{ $reactImports }} } from 'react'
        [e] import-navigate
            [v] import { {{ $routerImports }} } from '@tanstack/react-router'
        [e] import-button
            [v] import { Button } from '@/components/ui/button'
        [e] import-icon
            [v] import { resolveIcon } from '@/runtime/icons'
        [e] link-icon-const
            [v] const {{ mi:first-upper(normalize-space(value)) }}Icon = resolveIcon('{{ normalize-space(properties/icon/value) }}')
        [e] links-start
            [v] {{ '' }}
            [v]   const links = (
            [v]     <>
        [e] link-item
            [v]       <Button variant="outline" asChild>
            [v]         <Link to="{{ normalize-space(properties/route/value) }}">
            [v]           <{{ mi:first-upper(normalize-space(value)) }}Icon /> {{ normalize-space(properties/label/pt/value) }}
            [v]         </Link>
            [v]       </Button>
        [e] links-end
            [v]     </>
            [v]   )
        [e] import-dialog
            [v] import { Button } from '@/components/ui/button'
            [v] import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
        [e] import-auth
            [v] import { canAct, useSession } from '@/lib/auth'
        [e] import-runtime
            [v] import { DataTable, type Facet } from '@/runtime/DataTable'
        [e] import-feedback
            [v] import { mutationFeedback } from '@/runtime/feedback'
            [v] import { resolveIcon } from '@/runtime/icons'
        [e] import-tablestate
            [v] import { useTableState } from '@/runtime/table-state'
        [e] import-api
            [v] import { {{ $apiImports }} } from '@/gen/api/{{ $entity }}'
        [e] import-schema
            [v] import { {{ $facetImports }} } from '@/gen/schemas/{{ $entity }}'
        [e] import-columns
            [v] import { {{ mi:first-lower(@name) }}Columns } from './columns'
        [e] import-form
            [v] import { {{ $createName }}Form } from '{{ $createPath }}'
        [e] icon-const
            [v] {{ '' }}
            [v] const {{ mi:first-upper($createId) }}Icon = resolveIcon('{{ $createIcon }}')
        [e] facets-start
            [v] {{ '' }}
            [v] const FACETS: Facet[] = [
        [e] facets-end
            [v] ]
        [e] facet-line
            [v]   { id: '{{ $fname }}', title: '{{ $ftitle }}', options: {{ $fname }}Values.map((value) => ({ value, label: {{ $fname }}Labels[value] })) },
        [e] facet-bool-line
            [v]   { id: '{{ $fname }}', title: '{{ $ftitle }}', options: [{ value: 'true', label: 'Sim' }, { value: 'false', label: 'Não' }] },
        [e] facet-todo
            [v]   // @TODO {{ $bean }}{{ normalize-space(value) }}: filtro nao tratado (so faceted sobre enum Texto ou Boolean)
        [e] columns-const
            [v] {{ '' }}
            [v] const columns = {{ mi:first-lower(@name) }}Columns()
        [e] component-start
            [v] {{ '' }}
            [v] export function {{ @name }}Screen() {
        [e] use-session
            [v]   const session = useSession()
        [e] use-navigate
            [v]   const navigate = useNavigate()
        [e] columns-memo-start
            [v]   const columns = useMemo(
            [v]     () =>
            [v]       {{ mi:first-lower(@name) }}Columns({
        [e] columns-memo-end
            [v]       }),
            [v]     [session, navigate],
            [v]   )
        [e] wire-edit
            [v]         {{ normalize-space(value) }}: canAct(session, '{{ $role }}', {{ $listPlatform }}) ? (row) => void navigate({ to: '{{ $route }}', params: { {{ $param }}: row.id } }) : undefined,
        [e] wire-todo
            [v]         // @TODO {{ normalize-space(value) }}: acao de linha sem destino window.editor com $id em opens
        [e] use-state-table
            [v]   const [state, update] = useTableState({ sortBy: '{{ $sortBy }}' })
            [v]   const result = use{{ $bean }}s(state, '{{ $searchField }}'{{ $filtrosArg }})
        [e] create-hooks
            [v]   const [dialogOpen, setDialogOpen] = useState(false)
            [v]   const criar = useCriar{{ $bean }}()
            [v]   const fb = mutationFeedback({ success: 'Registro salvo.', onDone: () => setDialogOpen(false) })
            [v]   const abrir = () => {
            [v]     criar.reset()
            [v]     setDialogOpen(true)
            [v]   }
            [v]   const canCriar = canAct(session, '{{ $createRole }}', {{ $platformOnly }})
            [v]   const novo = canCriar ? (
            [v]     <Button onClick={abrir}>
            [v]       <{{ mi:first-upper($createId) }}Icon /> {{ $createLabel }}
            [v]     </Button>
            [v]   ) : null
        [e] create-route
            [v]   const canCriar = canAct(session, '{{ $createRole }}', {{ $platformOnly }})
            [v]   const novo = canCriar ? (
            [v]     <Button onClick={() => void navigate({ to: '{{ $createRoute }}', params: { {{ $createParam }}: 'novo' } })}>
            [v]       <{{ mi:first-upper($createId) }}Icon /> {{ $createLabel }}
            [v]     </Button>
            [v]   ) : null
        [e] create-none
            [v]   const novo = null
        [e] empty-const
            [v]   const empty = { title: '{{ $emptyTitle }}', action: novo || undefined }
        [e] return-start
            [v]   return (
            [v]     <div className="flex flex-col gap-4">
            [v]       <h1 className="text-2xl font-semibold">{{ $title }}</h1>
            [v]       <DataTable
            [v]         columns={columns}
            [v]         result={result}
            [v]         state={state}
            [v]         onStateChange={update}
            [v]         getRowId={(r) => r.id}
            [v]         searchPlaceholder="{{ $placeholder }}"
            [v]         facets={FACETS}
        [e] toolbar-novo
            [v]         toolbarActions={novo}
        [e] toolbar-links
            [v]         toolbarActions={
            [v]           <>
            [v]             {novo}
            [v]             {links}
            [v]           </>
            [v]         }
        [e] return-table-end
            [v]         empty={empty}
            [v]       />
        [e] return-dialog
            [v]       <Dialog open={dialogOpen} onOpenChange={setDialogOpen}>
            [v]         <DialogContent className="sm:max-w-3xl">
            [v]           <DialogHeader>
            [v]             <DialogTitle>{{ $createTitle }}</DialogTitle>
            [v]           </DialogHeader>
            [v]           <{{ $createName }}Form
            [v]             isSubmitting={criar.isPending}
            [v]             serverError={criar.error}
            [v]             onCancel={() => setDialogOpen(false)}
            [v]             onSubmit={(v) => criar.mutateAsync(v).then(fb.onSuccess, () => {})}
            [v]           />
            [v]         </DialogContent>
            [v]       </Dialog>
        [e] return-end
            [v]     </div>
            [v]   )
            [v] }
    [e] start
        [e] match
            [v] /classes/class[@name = $modelName and @package = $package]
        [e] body
            [e] vars
                [e] var
                    [v] bean
                    [e] expr
                        [v] normalize-space(attributes/attribute[@name = 'object']/@type)
                [e] var
                    [v] entity
                    [e] expr
                        [v] mi:first-lower(normalize-space(attributes/attribute[@name = 'object']/@type))
                [e] var
                    [v] createAction
                    [e] expr
                        [v] (actions/action[normalize-space(properties/type/value) = 'primary' and exists(properties/opens/value)])[1]
                [e] var
                    [v] createName
                    [e] expr
                        [v] normalize-space($createAction/properties/opens/value)
                [e] var
                    [v] createClass
                    [e] expr
                        [v] ($classes/class[@name = $createName and (@mode = 'window.dialog' or @mode = 'window.editor')])[1]
                [e] var
                    [v] hasCreate
                    [e] expr
                        [v] exists($createClass)
                [e] var
                    [v] createId
                    [e] expr
                        [v] normalize-space($createAction/value)
                [e] var
                    [v] createIcon
                    [e] expr
                        [v] normalize-space($createAction/properties/icon/value)
                [e] var
                    [v] createLabel
                    [e] expr
                        [v] normalize-space($createAction/properties/label/pt/value)
                [e] var
                    [v] createTitle
                    [e] expr
                        [v] $createLabel
                [e] var
                    [v] createPath
                    [e] expr
                        [v] concat('@/features/', tokenize($createClass/@package, '[.]')[last() - 1], '/', tokenize($createClass/@package, '[.]')[last()], '/', $createName)
                [e] var
                    [v] createRole
                    [e] expr
                        [v] if (exists($createClass/properties/role/value)) then normalize-space($createClass/properties/role/value) else if (exists(properties/role/value)) then normalize-space(properties/role/value) else 'consulta'
                [e] var
                    [v] platformOnly
                    [e] expr
                        [v] if (normalize-space(properties/platformOnly/value) = 'true') then 'true' else 'false'
                [e] var
                    [v] rowActions
                    [e] expr
                        [v] actions/action[normalize-space(properties/type/value) = 'row']
                [e] var
                    [v] hasRows
                    [e] expr
                        [v] exists(actions/action[normalize-space(properties/type/value) = 'row'])
                [e] var
                    [v] usesRole
                    [e] expr
                        [v] $hasCreate or $hasRows
                [e] var
                    [v] createRoute
                    [e] expr
                        [v] normalize-space($createClass/properties/route/value)
                [e] var
                    [v] createParam
                    [e] expr
                        [v] substring-after($createRoute, '$')
                [e] var
                    [v] createByRoute
                    [e] expr
                        [v] $hasCreate and $createClass/@mode = 'window.editor' and contains($createRoute, '$')
                [e] var
                    [v] createByDialog
                    [e] expr
                        [v] $hasCreate and not($createByRoute)
                [e] var
                    [v] listOpens
                    [e] expr
                        [v] normalize-space(properties/opens/value)
                [e] var
                    [v] listOpensDialog
                    [e] expr
                        [v] $listOpens != '' and exists($classes/class[@name = $listOpens and @mode = 'window.dialog'])
                [e] var
                    [v] padraoViolado
                    [e] expr
                        [v] $createByDialog or $listOpensDialog
                [e] var
                    [v] badOpens
                    [e] expr
                        [v] if ($createByDialog) then $createName else $listOpens
                [e] var
                    [v] needsNavigate
                    [e] expr
                        [v] $hasRows or $createByRoute
                [e] var
                    [v] linkActions
                    [e] expr
                        [v] actions/action[normalize-space(properties/type/value) = 'link' and exists(properties/route/value)]
                [e] var
                    [v] hasLinks
                    [e] expr
                        [v] exists($linkActions)
                [e] var
                    [v] routerImports
                    [e] expr
                        [v] string-join((if ($hasLinks) then 'Link' else (), if ($needsNavigate) then 'useNavigate' else ()), ', ')
                [e] var
                    [v] reactImports
                    [e] expr
                        [v] string-join((if ($hasRows) then 'useMemo' else (), if ($createByDialog) then 'useState' else ()), ', ')
                [e] var
                    [v] apiImports
                    [e] expr
                        [v] string-join((concat('use', normalize-space(attributes/attribute[@name = 'object']/@type), 's'), if ($createByDialog) then concat('useCriar', normalize-space(attributes/attribute[@name = 'object']/@type)) else ()), ', ')
                [e] var
                    [v] facetImports
                    [e] expr
                        [v] string-join(distinct-values(for $f in filters/filter[normalize-space(properties/type/value) = 'faceted'] return (for $a in $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = substring(normalize-space($f/value), 2) and @mode = 'directToField' and exists(properties/values) and @type = $mapNativeTypes/String/value] return concat($a/@name, 'Values, ', $a/@name, 'Labels'))), ', ')
                [e] var
                    [v] searchField
                    [e] expr
                        [v] substring(normalize-space((search/field)[1]/value), 2)
                [e] var
                    [v] firstColumn
                    [e] expr
                        [v] substring(normalize-space((columns/field)[1]/value), 2)
                [e] var
                    [v] sortBy
                    [e] expr
                        [v] if ($searchField != '') then $searchField else $firstColumn
                [e] var
                    [v] filtrosArg
                    [e] expr
                        [v] if (exists(fixedFilter/field)) then concat(', { ', string-join(for $f in fixedFilter/field return (for $v in normalize-space($f/properties/value/value) return concat(substring(normalize-space($f/value), 2), ': ', if ($v = ('true', 'false') or functx:is-a-number($v)) then $v else concat("'", replace($v, "'", "\\'"), "'"))), ', '), ' }') else ''
                [e] var
                    [v] title
                    [e] expr
                        [v] replace(normalize-space(properties/title/pt/value), "'", "\\'")
                [e] var
                    [v] placeholder
                    [e] expr
                        [v] mi:if-else(exists(search/properties/placeholder/pt/value), normalize-space(search/properties/placeholder/pt/value), 'Buscar…')
                [e] var
                    [v] emptyTitle
                    [e] expr
                        [v] replace(mi:if-else(exists(emptyState/properties/message/pt/value), normalize-space(emptyState/properties/message/pt/value), 'Nenhum registro encontrado.'), "'", "\\'")
            [e] write-pattern
                [v] header
            [e] apply-templates
                [e] select
                    [v] fixedFilter/field
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                    [e] janela
                        [e] expr
                            [v] string(@name)
                [e] mode
                    [v] fixedErro
            [e] if
                [v] $padraoViolado
                [e] then
                    [e] write-pattern
                        [v] err-create-dialog
            [e] if
                [v] $reactImports != ''
                [e] then
                    [e] write-pattern
                        [v] import-react
            [e] if
                [v] $routerImports != ''
                [e] then
                    [e] write-pattern
                        [v] import-navigate
            [e] if
                [v] $createByDialog
                [e] then
                    [e] write-pattern
                        [v] import-dialog
                [e] else-if
                    [v] $hasLinks or $createByRoute
                    [e] then
                        [e] write-pattern
                            [v] import-button
            [e] if
                [v] $usesRole
                [e] then
                    [e] write-pattern
                        [v] import-auth
            [e] write-pattern
                [v] import-runtime
            [e] if
                [v] $createByDialog
                [e] then
                    [e] write-pattern
                        [v] import-feedback
                [e] else-if
                    [v] $hasLinks or $createByRoute
                    [e] then
                        [e] write-pattern
                            [v] import-icon
            [e] write-pattern
                [v] import-tablestate
            [e] write-pattern
                [v] import-api
            [e] if
                [v] $facetImports != ''
                [e] then
                    [e] write-pattern
                        [v] import-schema
            [e] write-pattern
                [v] import-columns
            [e] if
                [v] $createByDialog
                [e] then
                    [e] write-pattern
                        [v] import-form
            [e] if
                [v] $hasCreate
                [e] then
                    [e] write-pattern
                        [v] icon-const
            [e] if
                [v] $hasLinks
                [e] then
                    [e] apply-templates
                        [e] select
                            [v] $linkActions
                        [e] mode
                            [v] linkIcon
            [e] write-pattern
                [v] facets-start
            [e] apply-templates
                [e] select
                    [v] filters/filter
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                [e] mode
                    [v] facet
            [e] write-pattern
                [v] facets-end
            [e] if
                [v] not($hasRows)
                [e] then
                    [e] write-pattern
                        [v] columns-const
            [e] write-pattern
                [v] component-start
            [e] if
                [v] $usesRole
                [e] then
                    [e] write-pattern
                        [v] use-session
            [e] if
                [v] $needsNavigate
                [e] then
                    [e] write-pattern
                        [v] use-navigate
            [e] if
                [v] $hasRows
                [e] then
                    [e] write-pattern
                        [v] columns-memo-start
                    [e] apply-templates
                        [e] select
                            [v] $rowActions
                        [e] parameters
                            [e] listRole
                                [e] expr
                                    [v] mi:if-else(exists(properties/role/value), normalize-space(properties/role/value), 'consulta')
                            [e] listPlatform
                                [e] expr
                                    [v] $platformOnly
                        [e] mode
                            [v] rowWire
                    [e] write-pattern
                        [v] columns-memo-end
            [e] write-pattern
                [v] use-state-table
            [e] if
                [v] $createByDialog
                [e] then
                    [e] write-pattern
                        [v] create-hooks
                [e] else-if
                    [v] $createByRoute
                    [e] then
                        [e] write-pattern
                            [v] create-route
                [e] else
                    [e] write-pattern
                        [v] create-none
            [e] if
                [v] $hasLinks
                [e] then
                    [e] write-pattern
                        [v] links-start
                    [e] apply-templates
                        [e] select
                            [v] $linkActions
                        [e] mode
                            [v] linkItem
                    [e] write-pattern
                        [v] links-end
            [e] write-pattern
                [v] empty-const
            [e] write-pattern
                [v] return-start
            [e] if
                [v] $hasLinks
                [e] then
                    [e] write-pattern
                        [v] toolbar-links
                [e] else
                    [e] write-pattern
                        [v] toolbar-novo
            [e] write-pattern
                [v] return-table-end
            [e] if
                [v] $createByDialog
                [e] then
                    [e] write-pattern
                        [v] return-dialog
            [e] write-pattern
                [v] return-end
    [e] templates
        [e] mode
            [v] fixedErro
            [e] template
                [e] match
                    [v] field
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                    [e] janela
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] fname
                            [e] expr
                                [v] normalize-space(value)
                        [e] var
                            [v] attrName
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] attr
                            [e] expr
                                [v] $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $attrName and @mode = 'directToField']
                        [e] var
                            [v] fvalue
                            [e] expr
                                [v] normalize-space(properties/value/value)
                    [e] if
                        [v] not(exists($attr))
                        [e] then
                            [e] write-pattern
                                [v] err-fixed-field
                    [e] if
                        [v] $fvalue = ''
                        [e] then
                            [e] write-pattern
                                [v] err-fixed-value
        [e] mode
            [v] linkIcon
            [e] template
                [e] match
                    [v] action
                [e] body
                    [e] write-pattern
                        [v] link-icon-const
        [e] mode
            [v] linkItem
            [e] template
                [e] match
                    [v] action
                [e] body
                    [e] write-pattern
                        [v] link-item
        [e] mode
            [v] facet
            [e] template
                [e] match
                    [v] filter
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] fname
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] attr
                            [e] expr
                                [v] $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $fname and @mode = 'directToField' and ((exists(properties/values) and @type = $mapNativeTypes/String/value) or (not(exists(properties/values)) and @type = $mapNativeTypes/Boolean/value))]
                        [e] var
                            [v] ftitle
                            [e] expr
                                [v] replace(normalize-space(if (exists(properties/label/pt/value)) then properties/label/pt/value else $attr/properties/title/pt/value), "'", "\\'")
                    [e] if
                        [v] normalize-space(properties/type/value) = 'faceted' and exists($attr)
                        [e] then
                            [e] if
                                [v] exists($attr/properties/values)
                                [e] then
                                    [e] write-pattern
                                        [v] facet-line
                                [e] else
                                    [e] write-pattern
                                        [v] facet-bool-line
                        [e] else
                            [e] write-pattern
                                [v] facet-todo
        [e] mode
            [v] rowWire
            [e] template
                [e] match
                    [v] action
                [e] parameters
                    [e] listRole
                        [v] consulta
                    [e] listPlatform
                        [v] false
                [e] body
                    [e] vars
                        [e] var
                            [v] tgtName
                            [e] expr
                                [v] normalize-space(properties/opens/value)
                        [e] var
                            [v] tgt
                            [e] expr
                                [v] ($classes/class[@name = $tgtName])[1]
                        [e] var
                            [v] route
                            [e] expr
                                [v] normalize-space($tgt/properties/route/value)
                        [e] var
                            [v] param
                            [e] expr
                                [v] substring-after($route, '$')
                        [e] var
                            [v] role
                            [e] expr
                                [v] mi:if-else(exists($tgt/properties/role/value), normalize-space($tgt/properties/role/value), $listRole)
                    [e] if
                        [v] exists($tgt) and $tgt/@mode = 'window.editor' and contains($route, '$')
                        [e] then
                            [e] write-pattern
                                [v] wire-edit
                        [e] else
                            [e] write-pattern
                                [v] wire-todo
