[e] screenForm
    [e] parameters
        [e] modelName
            [v] NOT_DEFINED
        [e] package
            [v] NOT_DEFINED
    [e] vars
        [e] mapNativeTypes
            [e] select
                [v] //maps/mapNativeTypes
        [e] classes
            [e] select
                [v] /classes
    [e] fragments
        [e] maxLen
            [v] mi:if-else($attr/@typeParameter != '', concat(', maxLength: ', $attr/@typeParameter), '')
        [e] commonOpts
            [v] concat(mi:if-else(normalize-space($src/properties/required/value) = 'true', ', required: true', ''), mi:if-else(exists(properties/mask), concat(", mask: '", normalize-space(properties/mask/value), "'"), ''), mi:if-else(normalize-space(properties/size/value) = ('xs', 's', 'm', 'l', 'xl', 'full'), concat(", size: '", normalize-space(properties/size/value), "'"), ''), mi:if-else(exists(properties/hint/pt/value), concat(", hint: '", replace(normalize-space(properties/hint/pt/value), "'", "\\'"), "'"), ''), mi:if-else(exists(properties/lookup/value), concat(", lookup: '", normalize-space(properties/lookup/value), "'"), ''))
        [e] sectionOpts
            [v] concat(mi:if-else(exists(properties/description/pt/value), concat(", description: '", replace(normalize-space(properties/description/pt/value), "'", "\\'"), "'"), ''), mi:if-else(normalize-space(properties/collapsible/value) = 'true', ', collapsible: true', ''), mi:if-else(normalize-space(properties/defaultOpen/value) = 'true', ', defaultOpen: true', ''))
    [e] patterns
        [e] header
            [v] // GERADO por frontend/screenForm a partir de {{ @name }}. Nao edite: a saida e sobrescrita por inteiro.
        [e] header-imports
            [v] import { z } from 'zod'
            [v] import { AutoForm, type FieldLayout } from '@/runtime/AutoForm'
        [e] err-size-missing
            [v] // ERRO NO MODELO: campo {{ $fname }} sem size em {{ $janela }} (declare xs|s|m|l|xl|full)
        [e] err-size-invalid
            [v] // ERRO NO MODELO: campo {{ $fname }} com size '{{ $sz }}' invalido em {{ $janela }} (declare xs|s|m|l|xl|full)
        [e] err-lookup
            [v] // ERRO NO MODELO: campo {{ $fname }} com lookup '{{ $lk }}' em {{ $janela }} (so 'cep' e 'cnpj' sao aceitos)
        [e] err-row-sum
            [v] // ERRO NO MODELO: linha {{ concat('[', $names, ']') }} soma {{ $total }} colunas (esperado 12) em {{ $janela }}
        [e] err-section-title
            [v] // ERRO NO MODELO: secao sem titulo em {{ $janela }} (informe o titulo da secao)
        [e] import-fk
            [v] import { fkSource } from '@/lib/fk-sources'
        [e] import-schema
            [v] import { {{ concat($entity, 'Schema', mi:if-else($enumImports != '', concat(', ', $enumImports), '')) }} } from '@/gen/schemas/{{ $entity }}'
        [e] err-list-multiple
            [v] // ERRO NO MODELO: mais de uma list em {{ @name }} (so uma lista de detalhes por formulario e suportada)
        [e] err-list-not-detail
            [v] // ERRO NO MODELO: list {{ $lname }} sem relacao de detalhe [o] em {{ $bean }} na janela {{ $janela }} (declare [o] {{ substring($lname, 2) }}: Detalhe() no bean)
        [e] err-list-no-inverse
            [v] // ERRO NO MODELO: list {{ $lname }}: {{ $item }} nao tem relacao [m] para {{ $bean }} (janela {{ $janela }}); a relacao inversa carrega o pai
        [e] err-list-itemlabel
            [v] // ERRO NO MODELO: list {{ $lname }} sem itemLabel em {{ $janela }} (declare itemLabel no @ da list)
        [e] err-list-addlabel
            [v] // ERRO NO MODELO: list {{ $lname }} sem addLabel em {{ $janela }} (declare addLabel no @ da list)
        [e] err-list-maxitems
            [v] // ERRO NO MODELO: list {{ $lname }} com maxItems '{{ $maxItems }}' invalido em {{ $janela }} (inteiro de 1 a 100)
        [e] err-list-empty
            [v] // ERRO NO MODELO: list {{ $lname }} sem campos em {{ $janela }} (declare rows/row/field dentro da list)
        [e] err-list-nested
            [v] // ERRO NO MODELO: list {{ $lname }} com list aninhada em {{ $janela }} (nao suportado)
        [e] import-item-schema
            [v] import { {{ concat($ientity, 'Schema', mi:if-else($ienums != '', concat(', ', $ienums), '')) }} } from '@/gen/schemas/{{ $ientity }}'
        [e] schema-const-a
            [v] {{ '' }}
            [v] const SUBMIT_LABEL = '{{ replace(mi:if-else(exists(actions/action[normalize-space(properties/type/value) = 'primary']), normalize-space((actions/action[normalize-space(properties/type/value) = 'primary']/properties/label/pt/value)[1]), 'Salvar'), "'", "\\'") }}'
            [v] {{ '' }}
        [e] list-item-schema
            [v] /** Item de {{ $lname }}: so os campos que o formulario edita, mais o id do registro existente (ausente nos itens novos). */
            [v] const {{ $ientity }}ItemSchema = {{ $ientity }}Schema.pick({ {{ $ipicks }} }).extend({ id: z.string().optional() })
            [v] {{ '' }}
        [e] schema-const-b
            [v] const schema = {{ $entity }}Schema.pick({ {{ $picks }} })
        [e] list-extend
            [v]   .extend({ {{ $lname }}: z.array({{ $ientity }}ItemSchema){{ mi:if-else($maxItems != '', concat('.max(', $maxItems, ')'), '') }} })
        [e] list-default
            [v]   {{ $lname }}: [],
        [e] list-open
            [v] {{ '  [' }}
            [v]     {
            [v]       name: '{{ $lname }}', label: '{{ $lbl }}', kind: 'list', size: 'full',
            [v]       list: {
            [v]         itemLabel: '{{ $itemLabel }}', addLabel: '{{ $addLabel }}'{{ $listOpts }},
            [v]         item: [
        [e] list-close
            [v] {{ '        ],' }}
            [v] {{ '      },' }}
            [v] {{ '    },' }}
            [v] {{ '  ],' }}
        [e] schema-const-c
            [v] export type {{ @name }}Values = z.infer<typeof schema>
            [v] /** Campos que o formulario edita; o resto do registro e preservado no PUT (que substitui o registro inteiro). */
            [v] export const {{ @name }}FieldNames: readonly string[] = Object.keys(schema.shape)
        [e] defaults-start
            [v] {{ '' }}
            [v] const DEFAULTS: Partial<{{ @name }}Values> = {
        [e] defaults-end
            [v] }
        [e] default-line
            [v]   {{ $fname }}: {{ mi:if-else($attr/@type = $mapNativeTypes/String/value or $attr/@type = $mapNativeTypes/BigString/value, concat("'", normalize-space($attr/properties/defaultValue/value), "'"), normalize-space($attr/properties/defaultValue/value)) }},
        [e] fields-start
            [v] {{ '' }}
            [v] const FIELDS: FieldLayout = [
        [e] fields-end
            [v] ]
        [e] row-open
            [v] {{ '  [' }}
        [e] row-close
            [v] {{ '  ],' }}
        [e] spec-text
            [v]     { name: '{{ $fname }}', label: '{{ $lbl }}'{{ f#[maxLen] }}{{ f#[commonOpts] }} },
        [e] spec-textarea
            [v]     { name: '{{ $fname }}', label: '{{ $lbl }}', kind: 'textarea'{{ f#[maxLen] }}{{ f#[commonOpts] }} },
        [e] spec-number
            [v]     { name: '{{ $fname }}', label: '{{ $lbl }}', kind: 'number'{{ f#[commonOpts] }} },
        [e] spec-boolean
            [v]     { name: '{{ $fname }}', label: '{{ $lbl }}', kind: 'boolean'{{ f#[commonOpts] }} },
        [e] spec-date
            [v]     { name: '{{ $fname }}', label: '{{ $lbl }}', kind: 'date'{{ f#[commonOpts] }} },
        [e] spec-enum
            [v]     { name: '{{ $fname }}', label: '{{ $lbl }}', options: {{ $fname }}Values.map((value) => ({ value, label: {{ $fname }}Labels[value] })){{ f#[commonOpts] }} },
        [e] spec-fk
            [v]     { name: '{{ $fname }}', label: '{{ $lbl }}', fk: fkSource('{{ $rel/@type }}'){{ f#[commonOpts] }} },
        [e] section-item
            [v]   { section: '{{ replace(normalize-space(value), "'", "\\'") }}'{{ f#[sectionOpts] }} },
        [e] todo-relation
            [v]     // @TODO {{ $bean }}{{ normalize-space(value) }}: relacao to-many ({{ $rel/@type }}, {{ $rel/@mode }}) sem construto de lista no dialeto; campo omitido
        [e] todo-missing
            [v]     // @TODO {{ $bean }}{{ normalize-space(value) }}: atributo inexistente no dominio; campo omitido
        [e] todo-type
            [v]     // @TODO {{ $bean }}{{ normalize-space(value) }}: tipo nao tratado (type={{ $attr/@type }}); campo omitido
        [e] layout-todo
            [v]   // @TODO form/rows/{{ name() }}: elemento nao tratado
        [e] component
            [v] {{ '' }}
            [v] export interface {{ @name }}FormProps {
            [v]   /** Modo edicao: valores existentes (sem nulos). */
            [v]   values?: {{ @name }}Values
            [v]   onSubmit: (values: {{ @name }}Values) => void | Promise<void>
            [v]   isSubmitting?: boolean
            [v]   onCancel?: () => void
            [v]   serverError?: unknown
            [v]   submitLabel?: string
            [v] }
            [v] {{ '' }}
            [v] /** Formulario reutilizavel (dialog, pagina ou step): so compoe o AutoForm do runtime. */
            [v] export function {{ @name }}Form({ values, onSubmit, isSubmitting, onCancel, serverError, submitLabel }: {{ @name }}FormProps) {
            [v]   return (
            [v]     <AutoForm
            [v]       schema={schema}
            [v]       fields={FIELDS}
            [v]       defaults={DEFAULTS}
            [v]       values={values}
            [v]       isSubmitting={isSubmitting}
            [v]       serverError={serverError}
            [v]       onCancel={onCancel}
            [v]       onSubmit={onSubmit}
            [v]       submitLabel={submitLabel ?? SUBMIT_LABEL}
            [v]     />
            [v]   )
            [v] }
    [e] start
        [e] match
            [v] /classes/class[@name = $modelName and @package = $package]
        [e] body
            [e] vars
                [e] var
                    [v] bean
                    [e] expr
                        [v] normalize-space(attributes/attribute[@name = 'object']/@type)
                [e] var
                    [v] entity
                    [e] expr
                        [v] mi:first-lower(normalize-space(attributes/attribute[@name = 'object']/@type))
                [e] var
                    [v] enumImports
                    [e] expr
                        [v] string-join(distinct-values(for $f in form/rows//field[not(ancestor::list)] return (for $a in $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = substring(normalize-space($f/value), 2) and @mode = 'directToField' and exists(properties/values) and (@type = $mapNativeTypes/String/value or @type = $mapNativeTypes/Integer/value or @type = $mapNativeTypes/Long/value)] return concat($a/@name, 'Values, ', $a/@name, 'Labels'))), ', ')
                [e] var
                    [v] picks
                    [e] expr
                        [v] string-join(distinct-values(for $f in form/rows//field[not(ancestor::list)] return (for $a in $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = substring(normalize-space($f/value), 2) and (@mode = 'directToField' or @mode = 'oneToOne' or @mode = 'manyToOne')] return concat($a/@name, ': true'))), ', ')
                [e] var
                    [v] usesFk
                    [e] expr
                        [v] exists(for $f in form/rows//field[not(ancestor::list)] return $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = substring(normalize-space($f/value), 2) and (@mode = 'oneToOne' or @mode = 'manyToOne')])
                [e] var
                    [v] usesFkItem
                    [e] expr
                        [v] exists(for $l in form/rows/list, $ib in string(($classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = substring(normalize-space($l/value), 2) and @mode = 'oneToMany'])[1]/@type), $f in $l/rows//field return $classes/class[@name = $ib and @mode = 'bean']/attributes/attribute[@name = substring(normalize-space($f/value), 2) and (@mode = 'oneToOne' or @mode = 'manyToOne')])
                [e] var
                    [v] listCount
                    [e] expr
                        [v] count(form/rows/list)
            [e] write-pattern
                [v] header
            [e] apply-templates
                [e] select
                    [v] form/rows//field
                [e] parameters
                    [e] janela
                        [e] expr
                            [v] string(@name)
                [e] mode
                    [v] erroField
            [e] apply-templates
                [e] select
                    [v] form/rows/row
                [e] parameters
                    [e] janela
                        [e] expr
                            [v] string(@name)
                [e] mode
                    [v] erroRow
            [e] apply-templates
                [e] select
                    [v] form/rows/section
                [e] parameters
                    [e] janela
                        [e] expr
                            [v] string(@name)
                [e] mode
                    [v] erroSection
            [e] apply-templates
                [e] select
                    [v] form/rows/list/rows/row
                [e] parameters
                    [e] janela
                        [e] expr
                            [v] string(@name)
                [e] mode
                    [v] erroRow
            [e] apply-templates
                [e] select
                    [v] form/rows/list/rows/section
                [e] parameters
                    [e] janela
                        [e] expr
                            [v] string(@name)
                [e] mode
                    [v] erroSection
            [e] apply-templates
                [e] select
                    [v] form/rows/list
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                    [e] janela
                        [e] expr
                            [v] string(@name)
                [e] mode
                    [v] erroList
            [e] if
                [v] $listCount > 1
                [e] then
                    [e] write-pattern
                        [v] err-list-multiple
            [e] write-pattern
                [v] header-imports
            [e] if
                [v] $usesFk or $usesFkItem
                [e] then
                    [e] write-pattern
                        [v] import-fk
            [e] write-pattern
                [v] import-schema
            [e] apply-templates
                [e] select
                    [v] form/rows/list
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                [e] mode
                    [v] listImport
            [e] write-pattern
                [v] schema-const-a
            [e] apply-templates
                [e] select
                    [v] form/rows/list
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                [e] mode
                    [v] listItemSchema
            [e] write-pattern
                [v] schema-const-b
            [e] apply-templates
                [e] select
                    [v] form/rows/list
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                [e] mode
                    [v] listExtend
            [e] write-pattern
                [v] schema-const-c
            [e] write-pattern
                [v] defaults-start
            [e] apply-templates
                [e] select
                    [v] form/rows//field[not(ancestor::list)]
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                [e] mode
                    [v] defaults
            [e] apply-templates
                [e] select
                    [v] form/rows/list
                [e] mode
                    [v] listDefault
            [e] write-pattern
                [v] defaults-end
            [e] write-pattern
                [v] fields-start
            [e] apply-templates
                [e] select
                    [v] form/rows/*
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                [e] mode
                    [v] layout
            [e] write-pattern
                [v] fields-end
            [e] write-pattern
                [v] component
    [e] templates
        [e] mode
            [v] erroField
            [e] template
                [e] match
                    [v] field
                [e] parameters
                    [e] janela
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] fname
                            [e] expr
                                [v] normalize-space(value)
                        [e] var
                            [v] sz
                            [e] expr
                                [v] normalize-space(properties/size/value)
                        [e] var
                            [v] lk
                            [e] expr
                                [v] normalize-space(properties/lookup/value)
                        [e] var
                            [v] hasLookup
                            [e] expr
                                [v] exists(properties/lookup/value)
                    [e] if
                        [v] $sz = ''
                        [e] then
                            [e] write-pattern
                                [v] err-size-missing
                        [e] else-if
                            [v] not($sz = ('xs', 's', 'm', 'l', 'xl', 'full'))
                            [e] then
                                [e] write-pattern
                                    [v] err-size-invalid
                    [e] if
                        [v] $hasLookup and not($lk = ('cep', 'cnpj'))
                        [e] then
                            [e] write-pattern
                                [v] err-lookup
        [e] mode
            [v] erroRow
            [e] template
                [e] match
                    [v] row
                [e] parameters
                    [e] janela
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] sizes
                            [e] expr
                                [v] for $f in field return normalize-space($f/properties/size/value)
                        [e] var
                            [v] allSized
                            [e] expr
                                [v] every $s in $sizes satisfies $s = ('xs', 's', 'm', 'l', 'xl', 'full')
                        [e] var
                            [v] total
                            [e] expr
                                [v] sum(for $s in $sizes return (2, 3, 4, 6, 8, 12)[position() = index-of(('xs', 's', 'm', 'l', 'xl', 'full'), $s)[1]])
                        [e] var
                            [v] names
                            [e] expr
                                [v] string-join(for $f in field return normalize-space($f/value), ', ')
                    [e] if
                        [v] $allSized and $total != 12
                        [e] then
                            [e] write-pattern
                                [v] err-row-sum
        [e] mode
            [v] erroSection
            [e] template
                [e] match
                    [v] section
                [e] parameters
                    [e] janela
                        [v] NOT_DEFINED
                [e] body
                    [e] if
                        [v] normalize-space(value) = ''
                        [e] then
                            [e] write-pattern
                                [v] err-section-title
        [e] mode
            [v] defaults
            [e] template
                [e] match
                    [v] field
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] fname
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] attr
                            [e] expr
                                [v] $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $fname and @mode = 'directToField']
                    [e] if
                        [v] exists($attr/properties/defaultValue)
                        [e] then
                            [e] write-pattern
                                [v] default-line
        [e] mode
            [v] layout
            [e] template
                [e] match
                    [v] row
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] write-pattern
                        [v] row-open
                    [e] apply-templates
                        [e] select
                            [v] *
                        [e] parameters
                            [e] bean
                                [e] expr
                                    [v] $bean
                        [e] mode
                            [v] spec
                    [e] write-pattern
                        [v] row-close
            [e] template
                [e] match
                    [v] field
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] write-pattern
                        [v] row-open
                    [e] apply-templates
                        [e] select
                            [v] .
                        [e] parameters
                            [e] bean
                                [e] expr
                                    [v] $bean
                        [e] mode
                            [v] spec
                    [e] write-pattern
                        [v] row-close
            [e] template
                [e] match
                    [v] section
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] write-pattern
                        [v] section-item
            [e] template
                [e] match
                    [v] list
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] lname
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] rel
                            [e] expr
                                [v] $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $lname]
                        [e] var
                            [v] item
                            [e] expr
                                [v] normalize-space($rel/@type)
                        [e] var
                            [v] lbl
                            [e] expr
                                [v] replace(normalize-space((properties/label/pt/value, $rel/properties/title/pt/value)[1]), "'", "\\'")
                        [e] var
                            [v] itemLabel
                            [e] expr
                                [v] replace(normalize-space((properties/itemLabel/value, itemLabel/value)[1]), "'", "\\'")
                        [e] var
                            [v] addLabel
                            [e] expr
                                [v] replace(normalize-space((properties/addLabel/value, addLabel/value)[1]), "'", "\\'")
                        [e] var
                            [v] emptyText
                            [e] expr
                                [v] replace(normalize-space((properties/emptyText/value, emptyText/value)[1]), "'", "\\'")
                        [e] var
                            [v] maxItems
                            [e] expr
                                [v] normalize-space((properties/maxItems/value, maxItems/value)[1])
                        [e] var
                            [v] listOpts
                            [e] expr
                                [v] concat(mi:if-else($emptyText != '', concat(", emptyText: '", $emptyText, "'"), ''), mi:if-else($maxItems != '', concat(', maxItems: ', $maxItems), ''))
                    [e] write-pattern
                        [v] list-open
                    [e] apply-templates
                        [e] select
                            [v] rows/*
                        [e] parameters
                            [e] bean
                                [e] expr
                                    [v] $item
                        [e] mode
                            [v] layout
                    [e] write-pattern
                        [v] list-close
            [e] template
                [e] match
                    [v] *
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] write-pattern
                        [v] layout-todo
        [e] mode
            [v] erroList
            [e] template
                [e] match
                    [v] list
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                    [e] janela
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] lname
                            [e] expr
                                [v] normalize-space(value)
                        [e] var
                            [v] rel
                            [e] expr
                                [v] $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = substring($lname, 2)]
                        [e] var
                            [v] isDetail
                            [e] expr
                                [v] exists($rel) and $rel/@mode = 'oneToMany'
                        [e] var
                            [v] item
                            [e] expr
                                [v] normalize-space($rel/@type)
                        [e] var
                            [v] hasInverse
                            [e] expr
                                [v] exists($classes/class[@name = $item and @mode = 'bean']/attributes/attribute[@mode = 'manyToOne' and @type = $bean])
                        [e] var
                            [v] itemLabel
                            [e] expr
                                [v] normalize-space((properties/itemLabel/value, itemLabel/value)[1])
                        [e] var
                            [v] addLabel
                            [e] expr
                                [v] normalize-space((properties/addLabel/value, addLabel/value)[1])
                        [e] var
                            [v] maxItems
                            [e] expr
                                [v] normalize-space((properties/maxItems/value, maxItems/value)[1])
                        [e] var
                            [v] nFields
                            [e] expr
                                [v] count(rows//field)
                        [e] var
                            [v] nested
                            [e] expr
                                [v] exists(rows//list)
                    [e] if
                        [v] not($isDetail)
                        [e] then
                            [e] write-pattern
                                [v] err-list-not-detail
                    [e] if
                        [v] $isDetail and not($hasInverse)
                        [e] then
                            [e] write-pattern
                                [v] err-list-no-inverse
                    [e] if
                        [v] $itemLabel = ''
                        [e] then
                            [e] write-pattern
                                [v] err-list-itemlabel
                    [e] if
                        [v] $addLabel = ''
                        [e] then
                            [e] write-pattern
                                [v] err-list-addlabel
                    [e] if
                        [v] $maxItems != '' and not(matches($maxItems, '^[0-9]+$') and number($maxItems) >= 1 and number($maxItems) <= 100)
                        [e] then
                            [e] write-pattern
                                [v] err-list-maxitems
                    [e] if
                        [v] $nFields = 0
                        [e] then
                            [e] write-pattern
                                [v] err-list-empty
                    [e] if
                        [v] $nested
                        [e] then
                            [e] write-pattern
                                [v] err-list-nested
        [e] mode
            [v] listImport
            [e] template
                [e] match
                    [v] list
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] lname
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] item
                            [e] expr
                                [v] normalize-space($classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $lname]/@type)
                        [e] var
                            [v] ientity
                            [e] expr
                                [v] mi:first-lower($item)
                        [e] var
                            [v] ienums
                            [e] expr
                                [v] string-join(distinct-values(for $f in rows//field return (for $a in $classes/class[@name = $item and @mode = 'bean']/attributes/attribute[@name = substring(normalize-space($f/value), 2) and @mode = 'directToField' and exists(properties/values) and (@type = $mapNativeTypes/String/value or @type = $mapNativeTypes/Integer/value or @type = $mapNativeTypes/Long/value)] return concat($a/@name, 'Values, ', $a/@name, 'Labels'))), ', ')
                    [e] write-pattern
                        [v] import-item-schema
        [e] mode
            [v] listItemSchema
            [e] template
                [e] match
                    [v] list
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] lname
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] item
                            [e] expr
                                [v] normalize-space($classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $lname]/@type)
                        [e] var
                            [v] ientity
                            [e] expr
                                [v] mi:first-lower($item)
                        [e] var
                            [v] ipicks
                            [e] expr
                                [v] string-join(distinct-values(for $f in rows//field return (for $a in $classes/class[@name = $item and @mode = 'bean']/attributes/attribute[@name = substring(normalize-space($f/value), 2) and (@mode = 'directToField' or @mode = 'oneToOne' or @mode = 'manyToOne')] return concat($a/@name, ': true'))), ', ')
                    [e] write-pattern
                        [v] list-item-schema
        [e] mode
            [v] listExtend
            [e] template
                [e] match
                    [v] list
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] lname
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] item
                            [e] expr
                                [v] normalize-space($classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $lname]/@type)
                        [e] var
                            [v] ientity
                            [e] expr
                                [v] mi:first-lower($item)
                        [e] var
                            [v] maxItems
                            [e] expr
                                [v] normalize-space((properties/maxItems/value, maxItems/value)[1])
                    [e] write-pattern
                        [v] list-extend
        [e] mode
            [v] listDefault
            [e] template
                [e] match
                    [v] list
                [e] body
                    [e] vars
                        [e] var
                            [v] lname
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                    [e] write-pattern
                        [v] list-default
        [e] mode
            [v] spec
            [e] template
                [e] match
                    [v] field
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] fname
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] attr
                            [e] expr
                                [v] $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $fname and @mode = 'directToField']
                        [e] var
                            [v] rel
                            [e] expr
                                [v] $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $fname and @mode != 'directToField']
                        [e] var
                            [v] src
                            [e] expr
                                [v] ($attr, $rel)[1]
                        [e] var
                            [v] lbl
                            [e] expr
                                [v] replace(normalize-space((properties/label/pt/value, $src/properties/title/pt/value)[1]), "'", "\\'")
                    [e] if
                        [v] not(exists($attr)) and exists($rel) and ($rel/@mode = 'oneToOne' or $rel/@mode = 'manyToOne')
                        [e] then
                            [e] write-pattern
                                [v] spec-fk
                        [e] else-if
                            [v] not(exists($attr)) and exists($rel)
                            [e] then
                                [e] write-pattern
                                    [v] todo-relation
                        [e] else-if
                            [v] not(exists($attr))
                            [e] then
                                [e] write-pattern
                                    [v] todo-missing
                        [e] else-if
                            [v] exists($attr/properties/values) and ($attr/@type = $mapNativeTypes/Integer/value or $attr/@type = $mapNativeTypes/Long/value)
                            [e] then
                                [e] write-pattern
                                    [v] spec-enum
                        [e] else-if
                            [v] exists($attr/properties/values) and $attr/@type = $mapNativeTypes/String/value
                            [e] then
                                [e] write-pattern
                                    [v] spec-enum
                        [e] else-if
                            [v] exists($attr/properties/values)
                            [e] then
                                [e] write-pattern
                                    [v] todo-type
                        [e] else-if
                            [v] $attr/@type = $mapNativeTypes/Boolean/value
                            [e] then
                                [e] write-pattern
                                    [v] spec-boolean
                        [e] else-if
                            [v] $attr/@type = $mapNativeTypes/Integer/value or $attr/@type = $mapNativeTypes/Long/value or $attr/@type = $mapNativeTypes/Double/value or $attr/@type = $mapNativeTypes/BigDecimal/value
                            [e] then
                                [e] write-pattern
                                    [v] spec-number
                        [e] else-if
                            [v] $attr/@type = $mapNativeTypes/Date/value
                            [e] then
                                [e] write-pattern
                                    [v] spec-date
                        [e] else-if
                            [v] $attr/@type = $mapNativeTypes/BigString/value
                            [e] then
                                [e] write-pattern
                                    [v] spec-textarea
                        [e] else-if
                            [v] $attr/@type = $mapNativeTypes/String/value
                            [e] then
                                [e] write-pattern
                                    [v] spec-text
                        [e] else
                            [e] write-pattern
                                [v] todo-type
            [e] template
                [e] match
                    [v] *
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                [e] body
                    [e] write-pattern
                        [v] layout-todo
