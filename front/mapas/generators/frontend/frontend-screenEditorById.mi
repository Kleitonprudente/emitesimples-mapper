[e] screenEditorById
    [e] parameters
        [e] modelName
            [v] NOT_DEFINED
        [e] package
            [v] NOT_DEFINED
    [e] vars
        [e] classes
            [e] select
                [v] /classes
    [e] patterns
        [e] header
            [v] // GERADO por frontend/screenEditorById a partir de {{ @name }}. Nao edite: a saida e sobrescrita por inteiro.
        [e] import-navigate
            [v] import { useNavigate } from '@tanstack/react-router'
        [e] import-format
            [v] import { formatDateTime } from '@/runtime/format'
        [e] imports
            [v] import { useAtualizar{{ $bean }}, useCriar{{ $bean }}, use{{ $bean }} } from '@/gen/api/{{ $entity }}'
            [v] import { mutationFeedback } from '@/runtime/feedback'
            [v] import { ErrorState, LoadingState } from '@/runtime/states'
            [v] import { {{ @name }}Form, {{ @name }}FieldNames, type {{ @name }}Values } from './{{ @name }}'
        [e] err-list-multiple
            [v] // ERRO NO MODELO: mais de uma list em {{ @name }} (so uma lista de detalhes por formulario e suportada)
        [e] err-list-detail
            [v] // ERRO NO MODELO: list {{ $lname }} em {{ @name }} sem relacao de detalhe [o] em {{ $bean }} ou sem relacao inversa [m] no detalhe (veja o erro do formulario)
        [e] imports-list
            [v] import { useState } from 'react'
            [v] import { toast } from 'sonner'
            [v] import { useAtualizar{{ $bean }}, useCriar{{ $bean }}, use{{ $bean }}, {{ $hookLoad }}, {{ $hookSave }} } from '@/gen/api/{{ $entity }}'
            [v] import { errorMessage, mutationFeedback } from '@/runtime/feedback'
            [v] import { ErrorState, LoadingState } from '@/runtime/states'
            [v] import { {{ @name }}Form, {{ @name }}FieldNames, type {{ @name }}Values } from './{{ @name }}'
        [e] list-hooks-ops
            [v]   const {{ $saveVar }} = {{ $hookSave }}()
            [v]   const [salvando, setSalvando] = useState(false)
        [e] list-hook-load
            [v]   const {{ $loadedVar }} = {{ $hookLoad }}(id)
        [e] list-nav-only
            [v]   const navigate = useNavigate()
        [e] novo-salvar
            [v]   const salvarTudo = async (v: {{ @name }}Values) => {
            [v]     const { {{ $lname }}, ...dados } = v
            [v]     const salvo = await criar.mutateAsync({{ $createArg }}).catch(() => undefined)
            [v]     if (!salvo) return
            [v]     setSalvando(true)
            [v]     try {
            [v]       // O pai ja esta salvo; a lista de detalhes vai inteira num PUT atomico (tudo ou nada). Falha nao desfaz o pai.
            [v]       await {{ $saveVar }}.mutateAsync({ id: salvo.id, itens: {{ $lname }} })
            [v]     } catch (e) {
            [v]       toast.error(`{{ $nounCap }} {{ $salvoWord }}, mas {{ $artPl }} {{ $itemLower }}s não foram {{ $salvosWord }}: ${errorMessage(e)}. Revise na edição.`)
            [v]       void navigate({ to: '{{ $route }}', params: { id: salvo.id } })
            [v]       return
            [v]     } finally {
            [v]       setSalvando(false)
            [v]     }
            [v]     fb.onSuccess(salvo)
            [v]   }
        [e] novo-form-list
            [v]       <{{ @name }}Form
            [v]         isSubmitting={criar.isPending || salvando}
            [v]         serverError={criar.error}
        [e] novo-end-list
            [v]         onSubmit={salvarTudo}
            [v]       />
        [e] body-list
            [v]   if (loaded.isLoading || {{ $loadedVar }}.isLoading) return <LoadingState />
            [v]   if (loaded.isError || !loaded.data) return <ErrorState error={loaded.error} onRetry={() => void loaded.refetch()} />
            [v]   if ({{ $loadedVar }}.isError || !{{ $loadedVar }}.data) return <ErrorState {{ concat('error={', $loadedVar, '.error}') }} onRetry={() => void {{ $loadedVar }}.refetch()} />
            [v]   // O back devolve null nos opcionais ausentes; o schema do formulario espera ausente (undefined).
            [v]   const {{ $lname }}Atuais = {{ $loadedVar }}.data.map((c) => Object.fromEntries(Object.entries(c).filter(([, v]) => v !== null))) as unknown as {{ @name }}Values['{{ $lname }}']
            [v]   const values = { ...Object.fromEntries(Object.entries(loaded.data).filter(([, v]) => v !== null)), {{ $lname }}: {{ $lname }}Atuais } as {{ @name }}Values
            [v]   // O PUT substitui o registro inteiro: o que o formulario nao edita (ex.: referencias de integracao) segue como veio.
            [v]   const preservar = Object.fromEntries(Object.entries(values).filter(([k]) => !{{ @name }}FieldNames.includes(k)))
        [e] editar-salvar
            [v]   const salvarTudo = async (v: {{ @name }}Values) => {
            [v]     const { {{ $lname }}, ...dados } = v
            [v]     // A API responde 204 (sem corpo) ao atualizar: o sucesso vem da promessa, nao do retorno.
            [v]     const salvou = await salvar.mutateAsync({ ...preservar, ...dados } as typeof dados).then(() => true, () => false)
            [v]     if (!salvou) return
            [v]     setSalvando(true)
            [v]     try {
            [v]       // O pai ja esta salvo; a lista de detalhes vai inteira num PUT atomico (tudo ou nada). Falha nao desfaz o pai.
            [v]       await {{ $saveVar }}.mutateAsync({ id, itens: {{ $lname }} })
            [v]     } catch (e) {
            [v]       toast.error(`{{ $nounCap }} {{ $salvoWord }}, mas {{ $artPl }} {{ $itemLower }}s não foram {{ $salvosWord }}: ${errorMessage(e)}. Revise na edição.`)
            [v]       return
            [v]     } finally {
            [v]       setSalvando(false)
            [v]     }
            [v]     fb.onSuccess(undefined)
            [v]   }
        [e] body-form-list
            [v]       <{{ @name }}Form
            [v]         values={values}
            [v]         isSubmitting={salvar.isPending || salvando}
            [v]         serverError={salvar.error}
        [e] body-end-list
            [v]         onSubmit={salvarTudo}
            [v]       />
        [e] err-fixed-field
            [v] // ERRO NO MODELO: fixedValues {{ $fname }} sem atributo escalar correspondente em {{ $bean }} no editor {{ $janela }} (o campo deve existir como atributo do bean da source)
        [e] err-fixed-value
            [v] // ERRO NO MODELO: fixedValues {{ $fname }} sem value em {{ $janela }} (declare o valor literal: true|false|texto|numero)
        [e] err-fixed-in-form
            [v] // ERRO NO MODELO: fixedValues {{ $fname }} tambem aparece no formulario de {{ $janela }} (campo fixo nao pode ser editavel: tire-o do form)
        [e] fixed-const
            [v] {{ '' }}
            [v] /** Valores fixos deste cadastro: entram so na CRIACAO. Na edicao o PUT preserva o que o registro ja tem (ex.: a pessoa pode ser cliente e fornecedor). */
            [v] const FIXED_VALUES = { {{ $fixedObj }} }
        [e] component-start
            [v] {{ '' }}
            [v] // Rota unica: o id literal 'novo' cria; qualquer outro id edita. Dois componentes para os hooks nao dependerem do id.
            [v] export function {{ @name }}Screen({ id }: { id: string }) {
            [v]   return id === 'novo' ? <{{ @name }}Novo /> : <{{ @name }}Editar id={id} />
            [v] }
        [e] novo-start
            [v] {{ '' }}
            [v] function {{ @name }}Novo() {
            [v]   const criar = useCriar{{ $bean }}()
        [e] novo-head
            [v]   return (
            [v]     <div className="flex max-w-5xl flex-col gap-4">
            [v]       <h1 className="text-2xl font-semibold">{{ $newTitle }}</h1>
        [e] novo-form
            [v]       <{{ @name }}Form
            [v]         isSubmitting={criar.isPending}
            [v]         serverError={criar.error}
        [e] novo-end
            [v]         onSubmit={(v) => criar.mutateAsync(v).then(fb.onSuccess, () => {})}
            [v]       />
        [e] novo-end-fixed
            [v]         onSubmit={(v) => criar.mutateAsync({ ...v, ...FIXED_VALUES }).then(fb.onSuccess, () => {})}
            [v]       />
        [e] novo-close
            [v]     </div>
            [v]   )
            [v] }
        [e] import-tabs
            [v] import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs'
        [e] tab-import
            [v] import { {{ $comp }} } from '{{ $from }}'
        [e] tabs-novo-open
            [v]       <Tabs defaultValue="dados">
            [v]         <TabsList>
            [v]           <TabsTrigger value="dados">{{ $mainTitle }}</TabsTrigger>
        [e] tab-trigger-novo
            [v]           <TabsTrigger value="{{ $tabId }}" disabled>{{ $tabTitle }}</TabsTrigger>
        [e] tabs-novo-mid
            [v]         </TabsList>
            [v]         <p className="text-sm text-muted-foreground">{{ $saveMsg }}</p>
            [v]         <TabsContent value="dados">
        [e] tabs-novo-close
            [v]         </TabsContent>
            [v]       </Tabs>
        [e] tabs-edit-open
            [v]       <Tabs defaultValue="dados">
            [v]         <TabsList>
            [v]           <TabsTrigger value="dados">{{ $mainTitle }}</TabsTrigger>
        [e] tab-trigger-edit
            [v]           <TabsTrigger value="{{ $tabId }}">{{ $tabTitle }}</TabsTrigger>
        [e] tabs-edit-mid
            [v]         </TabsList>
            [v]         <TabsContent value="dados">
        [e] tab-content-edit
            [v]         <TabsContent value="{{ $tabId }}">
            [v]           <{{ $comp }} {{ $idProp }}={id} />
            [v]         </TabsContent>
        [e] tabs-edit-dados-end
            [v]         </TabsContent>
        [e] tabs-edit-close
            [v]       </Tabs>
        [e] err-tab-component
            [v] // ERRO NO MODELO: aba '{{ $tabTitle }}' sem component em {{ $janela }} (declare o nome do componente escrito a mao)
        [e] err-tab-from
            [v] // ERRO NO MODELO: aba '{{ $tabTitle }}' sem from em {{ $janela }} (declare o caminho de import em @/features/)
        [e] err-tab-from-invalid
            [v] // ERRO NO MODELO: aba '{{ $tabTitle }}' com from '{{ $from }}' invalido em {{ $janela }} (so componentes escritos a mao em @/features/ sao aceitos)
        [e] editar-start
            [v] {{ '' }}
            [v] function {{ @name }}Editar({ id }: { id: string }) {
            [v]   const loaded = use{{ $bean }}(id)
            [v]   const salvar = useAtualizar{{ $bean }}(id)
        [e] back-with-list
            [v]   const navigate = useNavigate()
            [v]   const voltar = () => void navigate({ to: '{{ $listRoute }}' })
            [v]   const fb = mutationFeedback({ success: 'Registro salvo.', onDone: voltar })
        [e] back-none
            [v]   const fb = mutationFeedback({ success: 'Registro salvo.' })
        [e] body
            [v]   if (loaded.isLoading) return <LoadingState />
            [v]   if (loaded.isError || !loaded.data) return <ErrorState error={loaded.error} onRetry={() => void loaded.refetch()} />
            [v]   // O back devolve null nos opcionais ausentes; o schema do formulario espera ausente (undefined).
            [v]   const values = Object.fromEntries(Object.entries(loaded.data).filter(([, v]) => v !== null)) as {{ @name }}Values
            [v]   // O PUT substitui o registro inteiro: o que o formulario nao edita (ex.: referencias de integracao) segue como veio.
            [v]   const preservar = Object.fromEntries(Object.entries(values).filter(([k]) => !{{ @name }}FieldNames.includes(k)))
        [e] body-head
            [v]   return (
            [v]     <div className="flex max-w-5xl flex-col gap-4">
            [v]       <h1 className="text-2xl font-semibold">{{ $title }}</h1>
        [e] body-form
            [v]       <{{ @name }}Form
            [v]         values={values}
            [v]         isSubmitting={salvar.isPending}
            [v]         serverError={salvar.error}
        [e] cancel-with-list
            [v]         onCancel={voltar}
        [e] body-end
            [v]         onSubmit={(v) => salvar.mutateAsync({ ...preservar, ...v } as typeof v).then(fb.onSuccess, () => {})}
            [v]       />
        [e] audit-line
            [v]       {loaded.data.dataCriacao && (
            [v]         <p className="text-xs text-muted-foreground">
            [v]           Criado em {formatDateTime(loaded.data.dataCriacao)}{loaded.data.dataAtualizacao ? <> &middot; Atualizado em {formatDateTime(loaded.data.dataAtualizacao)}</> : null}
            [v]         </p>
            [v]       )}
        [e] editar-close
            [v]     </div>
            [v]   )
            [v] }
        [e] todo-route
            [v] // @TODO {{ @name }}: rota sem $id ({{ $route }}); screenEditorById so trata window.editor com parametro de rota ou com singleton.
        [e] err-singleton-route
            [v] // ERRO NO MODELO: singleton {{ @name }} com $ na rota ({{ $route }}); singleton nao tem id na rota: tire o $id
        [e] err-singleton-empty
            [v] // ERRO NO MODELO: singleton {{ @name }} sem emptyState/message/pt (declare a mensagem do registro ausente)
        [e] singleton-imports
            [v] import { formatDateTime } from '@/runtime/format'
            [v] import { initialTableState } from '@/runtime/table-state'
            [v] import { useAtualizar{{ $bean }}, use{{ $bean }}, use{{ $bean }}s } from '@/gen/api/{{ $entity }}'
            [v] import { mutationFeedback } from '@/runtime/feedback'
            [v] import { EmptyState, ErrorState, LoadingState } from '@/runtime/states'
            [v] import { {{ @name }}Form, {{ @name }}FieldNames, type {{ @name }}Values } from './{{ @name }}'
        [e] singleton-start
            [v] {{ '' }}
            [v] // Registro UNICO (singleton): a lista gerada, escopada pelo back, traz no maximo um registro; ele e editado aqui.
            [v] // Nao ha criar nem voltar (front/mapas/README.md, "Editor singleton").
            [v] const PRIMEIRO = initialTableState({ pageSize: 1 })
            [v] {{ '' }}
            [v] export function {{ @name }}Screen() {
            [v]   const lista = use{{ $bean }}s(PRIMEIRO)
            [v]   if (lista.isLoading) return <LoadingState />
            [v]   if (lista.isError) return <ErrorState error={lista.error} onRetry={lista.refetch} />
            [v]   const id = lista.data?.[0]?.id
            [v]   if (!id) return <EmptyState title="{{ $title }}" description="{{ $emptyMsg }}" />
            [v]   return <{{ @name }}Editar id={id} />
            [v] }
            [v] {{ '' }}
            [v] function {{ @name }}Editar({ id }: { id: string }) {
            [v]   const loaded = use{{ $bean }}(id)
            [v]   const salvar = useAtualizar{{ $bean }}(id)
    [e] start
        [e] match
            [v] /classes/class[@name = $modelName and @package = $package]
        [e] body
            [e] vars
                [e] var
                    [v] bean
                    [e] expr
                        [v] normalize-space(attributes/attribute[@name = 'object']/@type)
                [e] var
                    [v] entity
                    [e] expr
                        [v] mi:first-lower(normalize-space(attributes/attribute[@name = 'object']/@type))
                [e] var
                    [v] route
                    [e] expr
                        [v] normalize-space(properties/route/value)
                [e] var
                    [v] title
                    [e] expr
                        [v] replace(normalize-space(properties/title/pt/value), "'", "\\'")
                [e] var
                    [v] newLabel
                    [e] expr
                        [v] normalize-space((for $c in $classes/class[@mode = 'window.list'] return $c/actions/action[normalize-space(properties/type/value) = 'primary' and normalize-space(properties/opens/value) = $modelName]/properties/label/pt/value)[1])
                [e] var
                    [v] newTitle
                    [e] expr
                        [v] if ($newLabel != '') then $newLabel else concat('Novo ', $bean)
                [e] var
                    [v] listRoute
                    [e] expr
                        [v] normalize-space((for $c in $classes/class[@mode = 'window.list' and exists(actions/action/properties/opens/value[normalize-space(.) = $modelName])] return $c/properties/route/value)[1])
                [e] var
                    [v] singleton
                    [e] expr
                        [v] normalize-space(properties/singleton/value)
                [e] var
                    [v] emptyMsg
                    [e] expr
                        [v] replace(normalize-space(emptyState/properties/message/pt/value), '"', "'")
                [e] var
                    [v] hasAudit
                    [e] expr
                        [v] exists($classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = 'dataCriacao']) and exists($classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = 'dataAtualizacao'])
                [e] var
                    [v] hasTabs
                    [e] expr
                        [v] exists(extraTabs/tab)
                [e] var
                    [v] mainTitle
                    [e] expr
                        [v] if (normalize-space((mainTabTitle/value)[1]) != '') then replace(normalize-space((mainTabTitle/value)[1]), "'", "\\'") else 'Dados'
                [e] var
                    [v] idProp
                    [e] expr
                        [v] concat(mi:first-lower($bean), 'Id')
                [e] var
                    [v] saveMsg
                    [e] expr
                        [v] concat('Salve ', if (ends-with($bean, 'a') or ends-with($bean, 'A')) then 'a ' else 'o ', lower-case($bean), ' para continuar.')
                [e] var
                    [v] hasFixedValues
                    [e] expr
                        [v] exists(fixedValues/field)
                [e] var
                    [v] formFields
                    [e] expr
                        [v] for $f in form/rows//field[not(ancestor::list)] return normalize-space($f/value)
                [e] var
                    [v] fixedObj
                    [e] expr
                        [v] string-join(for $f in fixedValues/field return (for $v in normalize-space($f/properties/value/value) return concat(substring(normalize-space($f/value), 2), ': ', if ($v = ('true', 'false') or functx:is-a-number($v)) then $v else concat("'", replace($v, "'", "\\'"), "'"))), ', ')
                [e] var
                    [v] hasList
                    [e] expr
                        [v] exists(form/rows/list)
                [e] var
                    [v] listCount
                    [e] expr
                        [v] count(form/rows/list)
                [e] var
                    [v] lst
                    [e] expr
                        [v] (form/rows/list)[1]
                [e] var
                    [v] lname
                    [e] expr
                        [v] substring(normalize-space($lst/value), 2)
                [e] var
                    [v] item
                    [e] expr
                        [v] normalize-space($classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $lname and @mode = 'oneToMany']/@type)
                [e] var
                    [v] ientity
                    [e] expr
                        [v] mi:first-lower($item)
                [e] var
                    [v] inv
                    [e] expr
                        [v] string(($classes/class[@name = $item and @mode = 'bean']/attributes/attribute[@mode = 'manyToOne' and @type = $bean]/@name)[1])
                [e] var
                    [v] itemLower
                    [e] expr
                        [v] lower-case(normalize-space(($lst/properties/itemLabel/value, $lst/itemLabel/value)[1]))
                [e] var
                    [v] itemFields
                    [e] expr
                        [v] string-join(for $f in $lst/rows//field return concat("'", substring(normalize-space($f/value), 2), "'"), ', ')
                [e] var
                    [v] loadedVar
                    [e] expr
                        [v] concat($lname, 'Loaded')
                [e] var
                    [v] createArg
                    [e] expr
                        [v] if ($hasFixedValues) then '{ ...dados, ...FIXED_VALUES }' else 'dados'
                [e] var
                    [v] noun
                    [e] expr
                        [v] lower-case(if ($newLabel != '' and contains($newLabel, ' ')) then substring-after($newLabel, ' ') else $bean)
                [e] var
                    [v] nounCap
                    [e] expr
                        [v] mi:first-upper($noun)
                [e] var
                    [v] salvoWord
                    [e] expr
                        [v] if (ends-with($noun, 'a')) then 'salva' else 'salvo'
                [e] var
                    [v] salvosWord
                    [e] expr
                        [v] if (ends-with($itemLower, 'a')) then 'salvas' else 'salvos'
                [e] var
                    [v] artPl
                    [e] expr
                        [v] if (ends-with($itemLower, 'a')) then 'as' else 'os'
                [e] var
                    [v] hookLoad
                    [e] expr
                        [v] concat('use', mi:first-upper($lname), 'De', $bean)
                [e] var
                    [v] hookSave
                    [e] expr
                        [v] concat('useSalvar', mi:first-upper($lname), 'De', $bean)
                [e] var
                    [v] saveVar
                    [e] expr
                        [v] concat('salvar', mi:first-upper($lname))
            [e] write-pattern
                [v] header
            [e] if
                [v] $listCount > 1
                [e] then
                    [e] write-pattern
                        [v] err-list-multiple
            [e] if
                [v] $hasList and ($item = '' or $inv = '')
                [e] then
                    [e] write-pattern
                        [v] err-list-detail
            [e] apply-templates
                [e] select
                    [v] fixedValues/field
                [e] parameters
                    [e] bean
                        [e] expr
                            [v] $bean
                    [e] janela
                        [e] expr
                            [v] string(@name)
                    [e] formFields
                        [e] expr
                            [v] $formFields
                [e] mode
                    [v] fixedErro
            [e] if
                [v] contains($route, '$') and $singleton != 'true'
                [e] then
                    [e] if
                        [v] $listRoute != '' or $hasList
                        [e] then
                            [e] write-pattern
                                [v] import-navigate
                    [e] if
                        [v] $hasAudit
                        [e] then
                            [e] write-pattern
                                [v] import-format
                    [e] apply-templates
                        [e] select
                            [v] extraTabs/tab
                        [e] parameters
                            [e] janela
                                [e] expr
                                    [v] string(@name)
                        [e] mode
                            [v] tabErro
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] imports-list
                        [e] else
                            [e] write-pattern
                                [v] imports
                    [e] if
                        [v] $hasTabs
                        [e] then
                            [e] write-pattern
                                [v] import-tabs
                            [e] apply-templates
                                [e] select
                                    [v] extraTabs/tab
                                [e] mode
                                    [v] tabImport
                    [e] if
                        [v] $hasFixedValues
                        [e] then
                            [e] write-pattern
                                [v] fixed-const
                    [e] write-pattern
                        [v] component-start
                    [e] write-pattern
                        [v] novo-start
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] list-hooks-ops
                    [e] if
                        [v] $listRoute != ''
                        [e] then
                            [e] write-pattern
                                [v] back-with-list
                        [e] else
                            [e] write-pattern
                                [v] back-none
                            [e] if
                                [v] $hasList
                                [e] then
                                    [e] write-pattern
                                        [v] list-nav-only
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] novo-salvar
                    [e] write-pattern
                        [v] novo-head
                    [e] if
                        [v] $hasTabs
                        [e] then
                            [e] write-pattern
                                [v] tabs-novo-open
                            [e] apply-templates
                                [e] select
                                    [v] extraTabs/tab
                                [e] mode
                                    [v] tabTriggerNovo
                            [e] write-pattern
                                [v] tabs-novo-mid
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] novo-form-list
                        [e] else
                            [e] write-pattern
                                [v] novo-form
                    [e] if
                        [v] $listRoute != ''
                        [e] then
                            [e] write-pattern
                                [v] cancel-with-list
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] novo-end-list
                    [e] if
                        [v] not($hasList) and $hasFixedValues
                        [e] then
                            [e] write-pattern
                                [v] novo-end-fixed
                    [e] if
                        [v] not($hasList) and not($hasFixedValues)
                        [e] then
                            [e] write-pattern
                                [v] novo-end
                    [e] if
                        [v] $hasTabs
                        [e] then
                            [e] write-pattern
                                [v] tabs-novo-close
                    [e] write-pattern
                        [v] novo-close
                    [e] write-pattern
                        [v] editar-start
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] list-hook-load
                            [e] write-pattern
                                [v] list-hooks-ops
                    [e] if
                        [v] $listRoute != ''
                        [e] then
                            [e] write-pattern
                                [v] back-with-list
                        [e] else
                            [e] write-pattern
                                [v] back-none
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] body-list
                            [e] write-pattern
                                [v] editar-salvar
                        [e] else
                            [e] write-pattern
                                [v] body
                    [e] write-pattern
                        [v] body-head
                    [e] if
                        [v] $hasTabs
                        [e] then
                            [e] write-pattern
                                [v] tabs-edit-open
                            [e] apply-templates
                                [e] select
                                    [v] extraTabs/tab
                                [e] mode
                                    [v] tabTriggerEdit
                            [e] write-pattern
                                [v] tabs-edit-mid
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] body-form-list
                        [e] else
                            [e] write-pattern
                                [v] body-form
                    [e] if
                        [v] $listRoute != ''
                        [e] then
                            [e] write-pattern
                                [v] cancel-with-list
                    [e] if
                        [v] $hasList
                        [e] then
                            [e] write-pattern
                                [v] body-end-list
                        [e] else
                            [e] write-pattern
                                [v] body-end
                    [e] if
                        [v] $hasTabs
                        [e] then
                            [e] write-pattern
                                [v] tabs-edit-dados-end
                            [e] apply-templates
                                [e] select
                                    [v] extraTabs/tab
                                [e] parameters
                                    [e] idProp
                                        [e] expr
                                            [v] $idProp
                                [e] mode
                                    [v] tabContentEdit
                            [e] write-pattern
                                [v] tabs-edit-close
                    [e] if
                        [v] $hasAudit
                        [e] then
                            [e] write-pattern
                                [v] audit-line
                    [e] write-pattern
                        [v] editar-close
                [e] else-if
                    [v] $singleton = 'true'
                    [e] then
                        [e] if
                            [v] contains($route, '$')
                            [e] then
                                [e] write-pattern
                                    [v] err-singleton-route
                            [e] else-if
                                [v] $emptyMsg = ''
                                [e] then
                                    [e] write-pattern
                                        [v] err-singleton-empty
                            [e] else
                                [e] write-pattern
                                    [v] singleton-imports
                                [e] write-pattern
                                    [v] singleton-start
                                [e] write-pattern
                                    [v] back-none
                                [e] write-pattern
                                    [v] body
                                [e] write-pattern
                                    [v] body-head
                                [e] write-pattern
                                    [v] body-form
                                [e] write-pattern
                                    [v] body-end
                                [e] if
                                    [v] $hasAudit
                                    [e] then
                                        [e] write-pattern
                                            [v] audit-line
                                [e] write-pattern
                                    [v] editar-close
                [e] else
                    [e] write-pattern
                        [v] todo-route
    [e] templates
        [e] mode
            [v] fixedErro
            [e] template
                [e] match
                    [v] field
                [e] parameters
                    [e] bean
                        [v] NOT_DEFINED
                    [e] janela
                        [v] NOT_DEFINED
                    [e] formFields
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] fname
                            [e] expr
                                [v] normalize-space(value)
                        [e] var
                            [v] attrName
                            [e] expr
                                [v] substring(normalize-space(value), 2)
                        [e] var
                            [v] attr
                            [e] expr
                                [v] $classes/class[@name = $bean and @mode = 'bean']/attributes/attribute[@name = $attrName and @mode = 'directToField']
                        [e] var
                            [v] fvalue
                            [e] expr
                                [v] normalize-space(properties/value/value)
                    [e] if
                        [v] not(exists($attr))
                        [e] then
                            [e] write-pattern
                                [v] err-fixed-field
                    [e] if
                        [v] $fvalue = ''
                        [e] then
                            [e] write-pattern
                                [v] err-fixed-value
                    [e] if
                        [v] $fname = $formFields
                        [e] then
                            [e] write-pattern
                                [v] err-fixed-in-form
        [e] mode
            [v] tabErro
            [e] template
                [e] match
                    [v] tab
                [e] parameters
                    [e] janela
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] tabTitle
                            [e] expr
                                [v] normalize-space(value)
                        [e] var
                            [v] comp
                            [e] expr
                                [v] normalize-space(properties/component/value)
                        [e] var
                            [v] from
                            [e] expr
                                [v] normalize-space(properties/from/value)
                    [e] if
                        [v] $comp = ''
                        [e] then
                            [e] write-pattern
                                [v] err-tab-component
                    [e] if
                        [v] $from = ''
                        [e] then
                            [e] write-pattern
                                [v] err-tab-from
                        [e] else-if
                            [v] not(starts-with($from, '@/features/'))
                            [e] then
                                [e] write-pattern
                                    [v] err-tab-from-invalid
        [e] mode
            [v] tabImport
            [e] template
                [e] match
                    [v] tab
                [e] body
                    [e] vars
                        [e] var
                            [v] comp
                            [e] expr
                                [v] normalize-space(properties/component/value)
                        [e] var
                            [v] from
                            [e] expr
                                [v] normalize-space(properties/from/value)
                    [e] write-pattern
                        [v] tab-import
        [e] mode
            [v] tabTriggerNovo
            [e] template
                [e] match
                    [v] tab
                [e] body
                    [e] vars
                        [e] var
                            [v] tabTitle
                            [e] expr
                                [v] normalize-space(value)
                        [e] var
                            [v] tabId
                            [e] expr
                                [v] mi:first-lower(normalize-space(properties/component/value))
                    [e] write-pattern
                        [v] tab-trigger-novo
        [e] mode
            [v] tabTriggerEdit
            [e] template
                [e] match
                    [v] tab
                [e] body
                    [e] vars
                        [e] var
                            [v] tabTitle
                            [e] expr
                                [v] normalize-space(value)
                        [e] var
                            [v] tabId
                            [e] expr
                                [v] mi:first-lower(normalize-space(properties/component/value))
                    [e] write-pattern
                        [v] tab-trigger-edit
        [e] mode
            [v] tabContentEdit
            [e] template
                [e] match
                    [v] tab
                [e] parameters
                    [e] idProp
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] tabId
                            [e] expr
                                [v] mi:first-lower(normalize-space(properties/component/value))
                        [e] var
                            [v] comp
                            [e] expr
                                [v] normalize-space(properties/component/value)
                    [e] write-pattern
                        [v] tab-content-edit
