[Descriptor.window.editor] FormularioEmpresa
    @
        [e] title
            [e] pt
                [v] Cadastro de empresa
        [e] route
            [v] /empresas/$id
        [e] platformOnly
            [v] true
        [e] icon
            [v] settings
    [g] source
        [r] object: Empresa()
    [e] form
        [e] rows
            [e] section
                [v] Identificação
            [e] row
                [e] field
                    [v] .razaoSocial
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .nomeFantasia
                    @
                        [e] size
                            [v] l
            [e] row
                [e] field
                    [v] .documento
                    @
                        [e] mask
                            [v] documento
                        [e] size
                            [v] m
                        [e] hint
                            [e] pt
                                [v] Ao sair do campo, os dados da empresa são preenchidos pelo CNPJ.ws.
                        [e] lookup
                            [v] cnpj
                [e] field
                    [v] .inscricaoMunicipal
                    @
                        [e] size
                            [v] m
                [e] field
                    [v] .rgInscricaoEstadual
                    @
                        [e] size
                            [v] m
            [e] section
                [v] Contato
            [e] row
                [e] field
                    [v] .email
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .whatsapp
                    @
                        [e] mask
                            [v] phone
                        [e] size
                            [v] s
                [e] field
                    [v] .telefone
                    @
                        [e] mask
                            [v] phone
                        [e] size
                            [v] s
            [e] section
                [v] Endereço
            [e] row
                [e] field
                    [v] .cep
                    @
                        [e] mask
                            [v] postalCode
                        [e] size
                            [v] s
                        [e] hint
                            [e] pt
                                [v] Ao sair do campo, o endereço é preenchido.
                        [e] lookup
                            [v] cep
                [e] field
                    [v] .logradouro
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .numeroEndereco
                    @
                        [e] size
                            [v] s
            [e] row
                [e] field
                    [v] .complemento
                    @
                        [e] size
                            [v] m
                [e] field
                    [v] .bairro
                    @
                        [e] size
                            [v] m
                [e] field
                    [v] .municipio
                    @
                        [e] label
                            [e] pt
                                [v] Município
                        [e] size
                            [v] m
            [e] section
                [v] Tributação
            [e] row
                [e] field
                    [v] .regimeTributario
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .regimeIbsCbs
                    @
                        [e] size
                            [v] l
            [e] section
                [v] Conta
            [e] row
                [e] field
                    [v] .situacao
                    @
                        [e] size
                            [v] m
                [e] field
                    [v] .urlWebhook
                    @
                        [e] size
                            [v] xl
    [e] extraTabs
        [e] tab
            [v] Usuários
            @
                [e] component
                    [v] VinculosDaEmpresa
                [e] from
                    [v] @/features/admin/VinculosDaEmpresa
    [e] actions
        [e] action
            [v] salvar
            @
                [e] type
                    [v] primary
                [e] label
                    [e] pt
                        [v] Salvar
