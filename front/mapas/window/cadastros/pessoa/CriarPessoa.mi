[Descriptor.window.dialog] CriarPessoa
    @
        [e] title
            [e] pt
                [v] Nova pessoa
        [e] role
            [v] operador
    [g] source
        [r] object: Pessoa()
    [e] form
        [e] rows
            [e] row
                [e] field
                    [v] .tipoPessoa
                [e] field
                    [v] .documento
            [e] field
                [v] .nome
            [e] row
                [e] field
                    [v] .email
                [e] field
                    [v] .telefone
                    @
                        [e] mask
                            [v] phone
            [e] row
                [e] field
                    [v] .cep
                    @
                        [e] mask
                            [v] postalCode
                        [e] width
                            [v] 30
                [e] field
                    [v] .logradouro
                    @
                        [e] width
                            [v] 70
            [e] row
                [e] field
                    [v] .numeroEndereco
                    @
                        [e] width
                            [v] 30
                [e] field
                    [v] .bairro
                    @
                        [e] width
                            [v] 70
    [e] actions
        [e] action
            [v] salvar
            @
                [e] type
                    [v] primary
                [e] label
                    [e] pt
                        [v] Salvar
