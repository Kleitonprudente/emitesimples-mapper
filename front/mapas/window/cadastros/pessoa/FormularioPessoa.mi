[Descriptor.window.editor] FormularioPessoa
    @
        [e] title
            [e] pt
                [v] Cadastro de pessoa
        [e] route
            [v] /pessoas/$id
        [e] role
            [v] operador
        [e] icon
            [v] user-pen
    [g] source
        [r] object: Pessoa()
    [e] form
        [e] rows
            [e] section
                [v] Identificação
            [e] row
                [e] field
                    [v] .tipoPessoa
                    @
                        [e] size
                            [v] s
                [e] field
                    [v] .documento
                    @
                        [e] size
                            [v] s
                [e] field
                    [v] .inscricaoMunicipal
                    @
                        [e] size
                            [v] s
                [e] field
                    [v] .rgInscricaoEstadual
                    @
                        [e] size
                            [v] s
            [e] row
                [e] field
                    [v] .nome
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .nomeFantasia
                    @
                        [e] size
                            [v] l
            [e] row
                [e] field
                    [v] .tipoDestinatario
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .consumidorFinal
                    @
                        [e] size
                            [v] l
            [e] section
                [v] Contato
            [e] row
                [e] field
                    [v] .email
                    @
                        [e] size
                            [v] xl
                [e] field
                    [v] .telefone
                    @
                        [e] mask
                            [v] phone
                        [e] size
                            [v] m
            [e] section
                [v] Endereço
            [e] row
                [e] field
                    [v] .cep
                    @
                        [e] mask
                            [v] postalCode
                        [e] size
                            [v] s
                        [e] hint
                            [e] pt
                                [v] Ao sair do campo, o endereço é preenchido.
                        [e] lookup
                            [v] cep
                [e] field
                    [v] .logradouro
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .numeroEndereco
                    @
                        [e] size
                            [v] s
            [e] row
                [e] field
                    [v] .complemento
                    @
                        [e] size
                            [v] m
                [e] field
                    [v] .bairro
                    @
                        [e] size
                            [v] m
                [e] field
                    [v] .cidade
                    @
                        [e] label
                            [e] pt
                                [v] Município
                        [e] size
                            [v] m
            [e] section
                [v] Pessoa estrangeira (exportação)
                @
                    [e] collapsible
                        [v] true
            [e] row
                [e] field
                    [v] .codigoPais
                    @
                        [e] size
                            [v] m
                [e] field
                    [v] .codigoPostal
                    @
                        [e] size
                            [v] xl
            [e] row
                [e] field
                    [v] .nomeMunicipioExterior
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .nomeProvincia
                    @
                        [e] size
                            [v] l
    [e] actions
        [e] action
            [v] salvar
            @
                [e] type
                    [v] primary
                [e] label
                    [e] pt
                        [v] Salvar
