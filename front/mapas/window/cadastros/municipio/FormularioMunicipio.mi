[Descriptor.window.editor] FormularioMunicipio
    @
        [e] title
            [e] pt
                [v] Cadastro de município
        [e] route
            [v] /municipios/$id
        [e] platformOnly
            [v] true
        [e] icon
            [v] settings
    [g] source
        [r] object: Municipio()
    [e] form
        [e] rows
            [e] row
                [e] field
                    [v] .codigoIbge
                    @
                        [e] size
                            [v] m
                [e] field
                    [v] .nome
                    @
                        [e] size
                            [v] l
                [e] field
                    [v] .uf
                    @
                        [e] size
                            [v] xs
    [e] actions
        [e] action
            [v] salvar
            @
                [e] type
                    [v] primary
                [e] label
                    [e] pt
                        [v] Salvar
