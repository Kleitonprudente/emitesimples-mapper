[Descriptor.window.list] GestaoFornecedores
    @
        [e] title
            [e] pt
                [v] Fornecedores
        [e] route
            [v] /fornecedores
        [e] role
            [v] OPERADOR
        [e] icon
            [v] package
        [e] group
            [v] Cadastros
        [e] order
            [v] 11
    [g] source
        [r] object: Pessoa()
    [e] fixedFilter
        [e] field
            [v] .fornecedor
            @
                [e] value
                    [v] true
    [e] columns
        [e] field
            [v] .documento
            @
                [e] mask
                    [v] documento
        [e] field
            [v] .nome
        [e] field
            [v] .tipoPessoa
            @
                [e] display
                    [v] badge
        [e] field
            [v] .email
        [e] field
            [v] .telefone
            @
                [e] mask
                    [v] phone
    [e] search
        @
            [e] placeholder
                [e] pt
                    [v] Buscar por nome…
        [e] field
            [v] .nome
    [e] filters
        [e] filter
            [v] .tipoPessoa
            @
                [e] type
                    [v] faceted
    [e] actions
        [e] action
            [v] criarFornecedor
            @
                [e] type
                    [v] primary
                [e] label
                    [e] pt
                        [v] Novo fornecedor
                [e] icon
                    [v] plus
                [e] opens
                    [v] FormularioFornecedor
        [e] action
            [v] editarFornecedor
            @
                [e] type
                    [v] row
                [e] label
                    [e] pt
                        [v] Editar
                [e] icon
                    [v] pencil
                [e] opens
                    [v] FormularioFornecedor
    [e] emptyState
        @
            [e] message
                [e] pt
                    [v] Nenhum fornecedor cadastrado ainda.
            [e] action
                [v] criarFornecedor
