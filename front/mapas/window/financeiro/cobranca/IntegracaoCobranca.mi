            [v] /financeiro/cobranca
        [e] role
            [v] ADMINISTRADOR
        [e] icon
            [v] landmark
        [e] group
            [v] Financeiro
        [e] order
            [v] 96
        [e] component
            [v] IntegracaoCobrancaScreen
        [e] from
            [v] @/features/financeiro/cobranca/IntegracaoCobranca
