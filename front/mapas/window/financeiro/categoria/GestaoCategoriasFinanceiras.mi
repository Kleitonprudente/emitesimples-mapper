[Descriptor.window.list] GestaoCategoriasFinanceiras
    @
        [e] title
            [e] pt
                [v] Categorias
        [e] route
            [v] /financeiro/categorias
        [e] role
            [v] ADMINISTRADOR
        [e] icon
            [v] tags
        [e] group
            [v] Financeiro
        [e] order
            [v] 20
    [g] source
        [r] object: CategoriaFinanceira()
    [e] columns
        [e] field
            [v] .nome
        [e] field
            [v] .tipo
        [e] field
            [v] .ativo
    [e] search
        @
            [e] placeholder
                [e] pt
                    [v] Buscar por nome…
        [e] field
            [v] .nome
    [e] filters
        [e] filter
            [v] .tipo
            @
                [e] type
                    [v] faceted
        [e] filter
            [v] .ativo
            @
                [e] type
                    [v] faceted
    [e] actions
        [e] action
            [v] importarExportarCsv
            @
                [e] type
                    [v] link
                [e] label
                    [e] pt
                        [v] Importar ou exportar CSV
                [e] icon
                    [v] upload
                [e] route
                    [v] /financeiro/csv
        [e] action
            [v] criarCategoriaFinanceira
            @
                [e] type
                    [v] primary
                [e] label
                    [e] pt
                        [v] Nova categoria
                [e] icon
                    [v] plus
                [e] opens
                    [v] FormularioCategoriaFinanceira
        [e] action
            [v] editarCategoriaFinanceira
            @
                [e] type
                    [v] row
                [e] label
                    [e] pt
                        [v] Editar
                [e] icon
                    [v] pencil
                [e] opens
                    [v] FormularioCategoriaFinanceira
    [e] emptyState
        @
            [e] message
                [e] pt
                    [v] Nenhuma categoria cadastrada ainda.
            [e] action
                [v] criarCategoriaFinanceira
