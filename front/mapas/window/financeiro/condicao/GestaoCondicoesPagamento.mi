[Descriptor.window.list] GestaoCondicoesPagamento
    @
        [e] title
            [e] pt
                [v] Condições de pagamento
        [e] route
            [v] /financeiro/condicoes
        [e] role
            [v] ADMINISTRADOR
        [e] icon
            [v] calendar-clock
        [e] group
            [v] Financeiro
        [e] order
            [v] 30
    [g] source
        [r] object: CondicaoPagamento()
    [e] columns
        [e] field
            [v] .nome
        [e] field
            [v] .forma
        [e] field
            [v] .parcelas
        [e] field
            [v] .ativo
    [e] search
        @
            [e] placeholder
                [e] pt
                    [v] Buscar por nome…
        [e] field
            [v] .nome
    [e] filters
        [e] filter
            [v] .forma
            @
                [e] type
                    [v] faceted
        [e] filter
            [v] .ativo
            @
                [e] type
                    [v] faceted
    [e] actions
        [e] action
            [v] importarExportarCsv
            @
                [e] type
                    [v] link
                [e] label
                    [e] pt
                        [v] Importar ou exportar CSV
                [e] icon
                    [v] upload
                [e] route
                    [v] /financeiro/csv
        [e] action
            [v] criarCondicaoPagamento
            @
                [e] type
                    [v] primary
                [e] label
                    [e] pt
                        [v] Nova condição
                [e] icon
                    [v] plus
                [e] opens
                    [v] FormularioCondicaoPagamento
        [e] action
            [v] editarCondicaoPagamento
            @
                [e] type
                    [v] row
                [e] label
                    [e] pt
                        [v] Editar
                [e] icon
                    [v] pencil
                [e] opens
                    [v] FormularioCondicaoPagamento
    [e] emptyState
        @
            [e] message
                [e] pt
                    [v] Nenhuma condição de pagamento cadastrada ainda.
            [e] action
                [v] criarCondicaoPagamento
