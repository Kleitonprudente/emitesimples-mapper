    [g] relacionamentos
        [r] empresa: Empresa()
            @
                [e] cn
                    [v] empresa_id
                [e] title
                    [e] pt
                        [v] Empresa
                    [e] en
                        [v] Company
                [e] description
                    [e] pt
                        [v] Empresa dona deste serviço e tenant do registro. Todo acesso é filtrado por ela.
                    [e] en
