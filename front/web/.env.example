# Ambiente: mock | dev | staging | prod (definido pelo --mode; os arquivos .env.<mode> ja trazem o valor)
VITE_APP_ENV=dev
# Alvo do proxy /api no servidor de desenvolvimento (so vite dev)
VITE_API_PROXY_TARGET=http://localhost:8080
# Opcional: sobrescreve a base da API (padrao /api, mesma origem)
# VITE_API_BASE=/api
