    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
