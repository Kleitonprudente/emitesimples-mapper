[p] br.com.emitesimples
    @
        [e] title
            [e] pt
                [v] Emite Simples
            [e] en
                [v] Emite Simples
        [e] description
            [e] pt
                [v] Emissor de NFS-e que usa o gateway IntegraNotas (API v2). Namespace raiz do modelo de negócio.
            [e] en
                [v] NFS-e issuer that uses the IntegraNotas gateway (API v2). Root namespace of the business model.
    config
        structVersion
            2
        [e] mapperidea
            [e] maps
                [e] mapNativeTypes
                    [e] String
                        [v] Texto
                    [e] BigString
                        [v] TextoLongo
                    [e] Integer
                        [v] Inteiro
                    [e] Long
                        [v] InteiroLongo
                    [e] Double
                        [v] Double
                    [e] BigDecimal
                        [v] ValorMonetario
                        [v] Decimal
                    [e] Boolean
                        [v] Boolean
                    [e] Date
                        [v] Data
                    [e] DateTime
                        [v] DataHora
                    [e] Binary
                        [v] Binario
                [e] toSwaggerTypes
                    [e] Texto
                        [v] string
                    [e] TextoLongo
                        [v] string
                    [e] Inteiro
                        [v] integer
                    [e] InteiroLongo
                        [v] integer
                    [e] ValorMonetario
                        [v] number
                    [e] Decimal
                        [v] number
                    [e] Double
                        [v] number
                    [e] Boolean
                        [v] boolean
                    [e] Data
                        [v] string
                    [e] DataHora
                        [v] string
                    [e] Binario
                        [v] string
                [e] bigDecimalDefaults
                    [e] precision
                        [v] 15
                    [e] scale
                        [v] 2
                    [e] scaleByType
