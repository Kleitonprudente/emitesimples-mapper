                    [e] Inteiro
                        [v] integer
                    [e] InteiroLongo
                        [v] integer
                    [e] ValorMonetario
                        [v] number
                    [e] Decimal
                        [v] number
                    [e] Double
                        [v] number
                    [e] Boolean
