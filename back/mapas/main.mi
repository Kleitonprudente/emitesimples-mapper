                    [e] BigString
                        [v] TextoLongo
                    [e] Integer
                        [v] Inteiro
                    [e] Long
                        [v] InteiroLongo
                    [e] Double
                        [v] Double
                    [e] BigDecimal
                        [v] ValorMonetario
                        [v] Decimal
                    [e] Boolean
